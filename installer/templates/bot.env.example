# =============================================================================
# QQ 机器人「哈基米」共享配置模板（唯一配置来源）
# agy-acp-wrapper.py / onebot-ws-guard.py / user_memory.py / bot_runner.py / webui
# 均从本文件读取配置。
#
# 提示：首次安装推荐直接运行一键安装脚本（或 `python setup_wizard.py`），
# 向导会自动生成正式的 `bot.env` 与 `config.toml` 并同步随机 Token。
#
# 手动修改说明：
# - 格式：KEY=VALUE，一行一个，值里不要有未加引号的空格。
# - 管理员 QQ 与 NapCat Token 同时存在于 config.toml 中（admin_from、
#   users.roles.admin.user_ids、platforms.options.token），启动时会校验一致性。
# - 修改后请重启机器人使配置生效。
# =============================================================================

# ---- 身份 ----
# 机器人使用的 QQ 小号（纯数字）
BOT_QQ_ID=1234567890
# 管理员 QQ 号，多个管理员请用英文逗号分隔，例如：1000000001,1000000002
ADMIN_QQ_IDS=1000000001
# 不理会的其他机器人 QQ 号（默认忽略腾讯官方「Q群管家」，避免机器人互刷）
IGNORED_BOT_QQ_IDS=2854196310
IGNORED_BOT_NAMES=q群管家

# ---- NapCat（OneBot v11 协议端，默认仅绑定本机回环地址）----
NAPCAT_HTTP_URL=http://127.0.0.1:3000
NAPCAT_WS_URL=ws://127.0.0.1:3001
# 与 NapCat onebot11.json 以及 config.toml 保持完全一致的随机密钥
NAPCAT_TOKEN=<NAPCAT_TOKEN>

# ---- ws-guard（防并发死锁 / 消息过滤 / 合并转发守护层）----
GUARD_LISTEN_PORT=3002
GUARD_UDP_PORT=3003
# 群聊单轮最长占用时间（秒），超时自动放行下一条
GUARD_BUSY_TTL_SECS=120
# 私聊单轮最长占用时间（秒），管理员私聊执行本地任务可能耗时较长
GUARD_DM_BUSY_TTL_SECS=900
# 是否开启群聊环境潜水监听（1 = 监听群内消息按策略决定是否插嘴；0 = 仅响应 @ 或点名）
GUARD_AMBIENT_LISTEN=1
# 群聊潜水消息送给模型判断的最小间隔（秒），减少低价值消息并发
GUARD_AMBIENT_GAP_SECS=20
# 潜水退避：模型连续输出 NO_REPLY 时上面的间隔逐次翻倍（20→40→80→160→封顶），
# 机器人发言或有人 @/回复/点名它时复位。1 = 开启；0 = 固定间隔
GUARD_AMBIENT_BACKOFF=1
GUARD_AMBIENT_MAX_GAP_SECS=300
# 每群每小时最多为潜水消息唤醒模型几次（0 = 不限）
GUARD_AMBIENT_MAX_PER_HOUR=20
# 没人点名的纯图/纯表情包：机器人没在聊天时，同一张图 1 小时内只看一次，
# 每 GUARD_IMAGE_AMBIENT_WINDOW_SECS 秒最多送 GUARD_IMAGE_AMBIENT_MAX 张给视觉模型
GUARD_IMAGE_BUDGET=1
GUARD_IMAGE_DEDUP_SECS=3600
GUARD_IMAGE_AMBIENT_WINDOW_SECS=600
GUARD_IMAGE_AMBIENT_MAX=1
# 潜水时送去看的图片缩到的最长边（像素，768 = 视觉模型的一个图块）
LURK_IMAGE_MAX_DIM=768
# 低信号过滤：纯“哈哈哈/草/666/嗯”这类叠词也算噪声，不唤醒模型（0 = 只过滤标点和 Emoji）
LOW_SIGNAL_FILLER=1
# 群聊白名单开关（1 = 仅响应下方 GROUP_WHITELIST_IDS 中的群，其他群静默忽略；0 = 不限制群）
GROUP_WHITELIST_ENABLED=0
# 群聊白名单 QQ 群号列表，英文逗号分隔（GROUP_WHITELIST_ENABLED=1 时生效）
GROUP_WHITELIST_IDS=

# ---- 复读（ws-guard 和 wrapper 共用）----
# 群里同一句话或同一个表情包连着出现 REPEAT_MIN_COUNT 条（至少 2 个不同的人发），
# 就把这条交给模型，由它决定跟不跟。模型要跟就只回 FOLLOW_REPEAT，ws-guard 原样复发。
# 1 开 / 0 关
REPEAT_ENABLED=1
REPEAT_MIN_COUNT=2
# 两条相同消息间隔超过该秒数则不算连续复读
REPEAT_WINDOW_SECS=180
# 同一个群两次询问模型是否跟风复读的最小冷却间隔（秒）
REPEAT_COOLDOWN_SECS=60
# 文本超过该字数则不视为复读
REPEAT_MAX_CHARS=60
# 普通图片的连续复读是否也交给模型判断（模型可看图）。1 开 / 0 关
REPEAT_PHOTOS=1
# 包含这些屏蔽词的消息不触发复读，英文逗号分隔（链接、长串数字、@、点名、/命令默认已排除）
REPEAT_BLOCK_WORDS=

# ---- 点名词与触发线索 ----
# 明确叫机器人名字的词（英文逗号分隔）
BOT_CALL_NAMES=哈基米,及其猫,机器猫,本猫,紫毛猫,紫发猫
# 疑似在叫机器人的称呼，会结合上下文判断（英文逗号分隔）
BOT_SOFT_CALL_CUES=猫猫,小猫,小紫,紫毛,紫发,那只猫,某猫,咪咪,哈基,及其,猫娘

# ---- Antigravity CLI / ACP 包装层 ----
# agy 可执行文件路径：留空则自动探测系统 PATH 及默认安装位置
# macOS 常见位置：~/.local/bin/agy 或 /opt/homebrew/bin/agy
# Windows 常见位置：%LOCALAPPDATA%\agy\bin\agy.exe
AGY_BIN=
# 不同场景下的思考强度：low / medium / high / xhigh
AGY_THOUGHT_LEVEL=medium
AGY_LURK_THOUGHT_LEVEL=low
AGY_TASK_THOUGHT_LEVEL=xhigh
# 管理员私聊会话的工作目录（可读写文件、执行命令）；留空默认使用 <项目目录>/workspace
AGY_WORK_DIR=
# 管理员私聊 Turbo 模式：1 = 改文件/跑命令等自动放行，不弹确认；0 = 逐条发私聊确认。仅影响管理员私聊
ADMIN_DM_TURBO=1
# 群聊与普通用户私聊的隔离沙箱目录（仅同步一份 GEMINI.md）；留空默认使用 <项目目录>/chat-sandbox
CHAT_SANDBOX_DIR=
# 群聊回复时最多附带最近多少条群聊历史上下文
GROUP_HISTORY_COUNT=30
# 群聊历史增量注入：首轮/压缩后给完整窗口，之后每轮只给模型上一轮之后新增的消息（0 = 每轮全量）
BOT_HISTORY_DELTA=1
# 提示词模式：lean = 规则块（权限/动作/风格/监听状态/历史查阅）只在首轮或变化时完整注入，
# 平时只有一行 [本轮状态]；full = 每轮全量注入（旧行为）
BOT_PROMPT_MODE=lean
# lean 模式下每隔多少轮重新完整注入一次规则块，防止长对话里规则被淡忘（0 = 不定期刷新）
BOT_PROMPT_REFRESH_TURNS=30
# 没人点名时主动冒泡接梗的频率限制：
# 两次至少隔 AMBIENT_MIN_GAP_SECS 秒，每 AMBIENT_WINDOW_SECS 秒内最多 AMBIENT_MAX_PER_WINDOW 次（0 = 不限次数）
# 刚说完话 ACTIVE_CONV_WINDOW_SECS 秒内，群友接话时可按 ACTIVE_CONV_MIN_GAP_SECS 更快跟一句；ACTIVE_CONV_MAX_PER_WINDOW=0 表示活跃接话不限次数
AMBIENT_MIN_GAP_SECS=45
AMBIENT_WINDOW_SECS=600
AMBIENT_MAX_PER_WINDOW=4
ACTIVE_CONV_WINDOW_SECS=60
ACTIVE_CONV_MIN_GAP_SECS=10
ACTIVE_CONV_MAX_PER_WINDOW=4
# 口癖去重词表（英文逗号分隔）：最近 BOT_OVERUSED_LOOKBACK 条回复出现过，下一轮自动提醒避开
BOT_OVERUSED_MOTIFS=猫条,冻干,本猫,好家伙,属于是,电费,插电,赛博,喵,草
BOT_OVERUSED_LOOKBACK=8
# 不超过该字数的单行闲聊回复，发送前自动将中文逗号改为空格并去掉句尾句号（0 关闭）
BOT_CASUAL_MAX_CHARS=30
# 最近多少条回复内若出现过“先垫语气词再说话”，下一轮提醒开头直接说正文（0 关闭）
BOT_FILLER_OPENER_LOOKBACK=4
# 模型把上游报错原文（如敏感词拦截）当成正文吐出时的兜底回复（潜水时静默，管理员私聊原样展示）
UPSTREAM_ERROR_REPLY="这个我接不住 换个话题吧"

# ---- 每用户长期记忆（SQLite v2 记忆引擎，群聊与私聊记忆严格隔离）----
USER_MEMORY_ENABLED=1
# SQLite 记忆数据库路径；留空默认使用 <项目目录>/data/memory.db
MEMORY_DB_PATH=
# v1 旧版 JSON 记忆目录（只读归档参考/迁移）；留空默认使用 <项目目录>/data/user_memories
USER_MEMORY_DIR=
# 后台记忆整理工作目录；留空默认使用 <项目目录>/data/memory_extractor_cwd
MEMORY_EXTRACTOR_CWD=
MEMORY_MODEL=gemini-4-neon
MEMORY_EFFORT=low
MEMORY_MAX_CONCURRENT_JOBS=2
# 是否启用群聊共享群记忆：1 开 / 0 关
MEMORY_GROUP_MEMORY_ENABLED=1
# 窗口提炼阈值：群聊/私聊累计有效消息条数与静默自动整理分钟数
MEMORY_GROUP_WINDOW_SIZE=12
MEMORY_DM_WINDOW_SIZE=6
MEMORY_IDLE_FLUSH_MINS=10
# 混合召回预算与去重（L2 最大条数、总字数上限、不重复轮数、L0 刷新轮数、事件半衰期天数）
MEMORY_RECALL_MAX_ITEMS=4
MEMORY_RECALL_MAX_CHARS=600
MEMORY_REPEAT_WINDOW_TURNS=10
MEMORY_L0_REFRESH_TURNS=12
MEMORY_EPISODIC_HALFLIFE_DAYS=21
# 新会话或重启后首轮续接最多回放多少轮私聊原始对话
MEMORY_CONTINUITY_DM_TURNS=12
# 夜间 Sleep 维护周期（自动去重合并、冲突检测、档案重整与冷数据归档）
MEMORY_SLEEP_ENABLED=1
MEMORY_SLEEP_START_HOUR=3
MEMORY_SLEEP_END_HOUR=6
MEMORY_EPISODIC_ARCHIVE_DAYS=60
MEMORY_RAW_RETENTION_DAYS=60
# 可选：外接 HTTP Embedding 服务（留空则纯本地三通道召回，零外部依赖）
MEMORY_EMBED_URL=
MEMORY_EMBED_MODEL=
MEMORY_EMBED_API_KEY=

# ---- 历史聊天记录自主翻查（本地归档 + NapCat 分页回溯 + 会话记录兜底）----
# 开启(1)后，当机器人不记得前文、超出近期条数或上下文被压缩丢失原文时，可自主翻查当前会话原始历史
CHAT_HISTORY_ENABLED=1
# 单轮回复最多允许机器人连续翻查多少次历史（例如先搜索再看上下文，建议 2~4）
CHAT_HISTORY_MAX_ROUNDS=3
# 每次翻查最多向 NapCat 往前翻几页（每页约 60 条，本地归档命中则无需翻页）
CHAT_HISTORY_NAPCAT_MAX_PAGES=6
# 本地历史归档保留天数（0 = 永久保留）
CHAT_HISTORY_RETENTION_DAYS=30

# ---- cc-connect（本地补丁开关）----
# 不往群里发送“消息已收到，将在当前任务完成后处理”提示
CC_SILENT_QUEUE_NOTICE=1
# 自动压缩上下文时不往群里发“正在压缩上下文...”提示（手动 /compress 仍会提示）
CC_SILENT_AUTO_COMPRESS=1
# 冷场空闲自动切换新会话时不往群里发“因空闲超过 X 分钟，已自动切换到新会话”提示（手动 /new 仍会提示）
CC_SILENT_IDLE_RESET=1

# ---- 长消息合并转发（ws-guard）----
# 单条回复超过 FORWARD_MIN_CHARS 字或 FORWARD_MIN_LINES 行时，自动转为“合并转发聊天记录”卡片防刷屏
# 群聊默认开；私聊默认关（方便管理员私聊直接阅读任务结果）。1 开 / 0 关
FORWARD_LONG_MSG_GROUP=1
FORWARD_LONG_MSG_DM=0
FORWARD_MIN_CHARS=300
FORWARD_MIN_LINES=12
# 合并转发卡片内每个气泡最多字数，长文优先按空行分段拆分
FORWARD_NODE_MAX_CHARS=800
# 合并转发卡片内显示的发送者昵称，留空则默认取 BOT_CALL_NAMES 的第一个
FORWARD_NICKNAME=
