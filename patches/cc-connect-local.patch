+++ b/core/autocompress_silent_test.go
@@ -0,0 +1,70 @@
+package core
+
+import (
+	"strings"
+	"testing"
+	"time"
+)
+
+// Local patch: CC_SILENT_AUTO_COMPRESS=1 must keep automatic compression out of
+// the chat, while the default behaviour still posts the "Compressing context" notice.
+func TestAutoCompress_SilentNoticeEnv(t *testing.T) {
+	for _, tc := range []struct {
+		name       string
+		env        string
+		wantNotice bool
+	}{
+		{"default posts notice", "", true},
+		{"silent env hides notice", "1", false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Setenv("CC_SILENT_AUTO_COMPRESS", tc.env)
+
+			p := &stubPlatformEngine{n: "test"}
+			sess := newQueuingSession("auto-compress-silent")
+			agent := &stubCompressorAgent{cmd: "/compact"}
+			e := NewEngine("test", agent, []Platform{p}, "", LangEnglish)
+			e.SetAutoCompressConfig(true, 4, 0)
+			sess.contextUsage = &ContextUsage{UsedTokens: 50_000, ContextWindow: 200_000}
+
+			key := "test:user1"
+			state := &interactiveState{agentSession: sess, platform: p, replyCtx: "ctx"}
+			e.interactiveMu.Lock()
+			e.interactiveStates[key] = state
+			e.interactiveMu.Unlock()
+			session := e.sessions.GetOrCreateActive(key)
+			session.AddHistory("user", "hello world")
+
+			go e.processInteractiveEvents(state, session, e.sessions, key, "msg1", time.Now(), func() {}, nil, nil, 0)
+			sess.events <- Event{Type: EventResult, Content: "response", Done: true}
+
+			// Wait until /compact reached the agent, i.e. auto-compress really ran.
+			deadline := time.After(2 * time.Second)
+			for {
+				sess.sendMu.Lock()
+				n := len(sess.sendCalls)
+				sess.sendMu.Unlock()
+				if n > 0 {
+					break
+				}
+				select {
+				case <-deadline:
+					t.Fatal("timed out waiting for auto-compress send")
+				default:
+					time.Sleep(10 * time.Millisecond)
+				}
+			}
+			time.Sleep(200 * time.Millisecond) // let any async platform send land
+
+			gotNotice := false
+			for _, m := range p.getSent() {
+				if strings.Contains(m, "Compressing context") {
+					gotNotice = true
+				}
+			}
+			if gotNotice != tc.wantNotice {
+				t.Fatalf("compress notice sent = %v, want %v (sent: %q)", gotNotice, tc.wantNotice, p.getSent())
+			}
+		})
+	}
+}
diff --git a/core/engine.go b/core/engine.go
index f1aad67..dece26d 100644
--- a/core/engine.go
+++ b/core/engine.go
@@ -442,7 +442,16 @@ type Engine struct {
 	// unaffected and always use the heuristic; see the gate in
 	// processInteractiveEvents.
 	autoCompressAllowHeuristic bool
-	resetOnIdle                time.Duration
+	// autoCompressHardMaxTokens is an optional hard ceiling (0 = disabled).
+	// When the estimate reaches it, auto-compress may fire before
+	// autoCompressMinGap has elapsed, so a very busy session does not keep
+	// growing far past max_tokens while it waits out the normal gap.
+	// autoCompressHardMinGapNanos still rate-limits that path so a compaction
+	// that leaves the context above the ceiling cannot thrash.
+	// Atomics because a config reload may update them while turns are running.
+	autoCompressHardMaxTokens   atomic.Int64
+	autoCompressHardMinGapNanos atomic.Int64
+	resetOnIdle                 time.Duration
 
 	// Reply footer composition flags. The footer renders up to two lines:
 	//   line 1 — model · [effort ·] out/in/cw/cr · ctx%   (gated by showContextIndicator)
@@ -984,6 +993,61 @@ func (e *Engine) SetAutoCompressConfigWithSource(enabled bool, maxTokens int, mi
 	e.autoCompressMinGap = minGap
 }
 
+// DefaultAutoCompressHardMinGap is the minimum spacing between auto-compress
+// runs triggered through the hard ceiling (see SetAutoCompressHardLimit).
+const DefaultAutoCompressHardMinGap = 3 * time.Minute
+
+// SetAutoCompressHardLimit configures the optional hard ceiling for automatic
+// context compression. When the estimate reaches hardMaxTokens (and is also at
+// or above max_tokens), auto-compress fires even if the normal min gap has not
+// elapsed yet, as long as at least hardMinGap has passed since the previous
+// automatic compression. hardMaxTokens <= 0 disables the ceiling, leaving the
+// original max_tokens + min_gap behavior unchanged. hardMinGap <= 0 falls back
+// to DefaultAutoCompressHardMinGap.
+func (e *Engine) SetAutoCompressHardLimit(hardMaxTokens int, hardMinGap time.Duration) {
+	if hardMaxTokens < 0 {
+		hardMaxTokens = 0
+	}
+	if hardMinGap <= 0 {
+		hardMinGap = DefaultAutoCompressHardMinGap
+	}
+	e.autoCompressHardMaxTokens.Store(int64(hardMaxTokens))
+	e.autoCompressHardMinGapNanos.Store(int64(hardMinGap))
+}
+
+// autoCompressDecision decides whether a turn whose context estimate is
+// `estimate` should auto-compress, given the time of the previous automatic
+// compression (`last`, zero if none). It returns the decision and the reason:
+//
+//   - "normal": estimate >= max_tokens and min_gap has elapsed (or no
+//     previous automatic compression);
+//   - "hard":   estimate >= max_tokens and >= hard_max_tokens, min_gap has
+//     not elapsed but hard_min_gap has;
+//   - "none":   no compression this turn.
+func (e *Engine) autoCompressDecision(estimate int, last, now time.Time) (bool, string) {
+	if estimate < e.autoCompressMaxTokens {
+		return false, "none"
+	}
+	if last.IsZero() {
