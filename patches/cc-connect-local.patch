@@ -0,0 +1,81 @@
+package config
+
+import "testing"
+
+// Local patch: [projects.auto_compress] hard_max_tokens / hard_min_gap_mins.
+
+const projectWithAutoCompressHardLimitFixture = `
+[[projects]]
+name = "beta"
+
+[projects.auto_compress]
+enabled = true
+max_tokens = 120000
+min_gap_mins = 60
+hard_max_tokens = 200000
+hard_min_gap_mins = 5
+
+[projects.agent]
+type = "codex"
+
+[projects.agent.options]
+work_dir = "/tmp/beta"
+
+[[projects.platforms]]
+type = "telegram"
+
+[projects.platforms.options]
+bot_token = "token_xxx"
+`
+
+const projectWithAutoCompressLegacyFixture = `
+[[projects]]
+name = "beta"
+
+[projects.auto_compress]
+enabled = true
+max_tokens = 120000
+min_gap_mins = 60
+
+[projects.agent]
+type = "codex"
+
+[projects.agent.options]
+work_dir = "/tmp/beta"
+
+[[projects.platforms]]
+type = "telegram"
+
+[projects.platforms.options]
+bot_token = "token_xxx"
+`
+
+func TestLoad_ParsesAutoCompressHardLimit(t *testing.T) {
+	cfg, err := Load(writeConfigFixture(t, projectWithAutoCompressHardLimitFixture))
+	if err != nil {
+		t.Fatalf("Load returned error: %v", err)
+	}
+	ac := cfg.Projects[0].AutoCompress
+	if ac.HardMaxTokens == nil || *ac.HardMaxTokens != 200000 {
+		t.Fatalf("hard_max_tokens = %v, want 200000", ac.HardMaxTokens)
+	}
+	if ac.HardMinGapMins == nil || *ac.HardMinGapMins != 5 {
+		t.Fatalf("hard_min_gap_mins = %v, want 5", ac.HardMinGapMins)
+	}
+}
+
+// Existing configs without the new keys must load unchanged: both stay nil,
+// which cmd/cc-connect maps to "hard limit disabled".
+func TestLoad_AutoCompressHardLimitDefaultsUnset(t *testing.T) {
+	cfg, err := Load(writeConfigFixture(t, projectWithAutoCompressLegacyFixture))
+	if err != nil {
+		t.Fatalf("Load returned error: %v", err)
+	}
+	ac := cfg.Projects[0].AutoCompress
+	if ac.HardMaxTokens != nil || ac.HardMinGapMins != nil {
+		t.Fatalf("expected hard_max_tokens/hard_min_gap_mins to default to nil, got %v / %v", ac.HardMaxTokens, ac.HardMinGapMins)
+	}
+	if ac.MaxTokens == nil || *ac.MaxTokens != 120000 || ac.MinGapMins == nil || *ac.MinGapMins != 60 {
+		t.Fatalf("legacy auto_compress keys not parsed as before: %+v", ac)
+	}
+}
