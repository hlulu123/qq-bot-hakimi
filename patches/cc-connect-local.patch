diff --git a/core/idlereset_silent_test.go b/core/idlereset_silent_test.go
new file mode 100644
index 0000000..4cf40e3
--- /dev/null
+++ b/core/idlereset_silent_test.go
@@ -0,0 +1,101 @@
+package core
+
+import (
+	"strings"
+	"testing"
+	"time"
+)
+
+// Local patch: CC_SILENT_IDLE_RESET=1 must keep automatic idle-reset notices
+// (both graceful-closing and auto-reset notifications) out of the chat while
+// still rotating to a fresh session; default behaviour still posts the notice.
+func TestAutoResetOnIdle_SilentNoticeEnv(t *testing.T) {
+	for _, tc := range []struct {
+		name       string
+		env        string
+		wantNotice bool
+	}{
+		{"default posts notice", "", true},
+		{"silent env hides notice", "1", false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Setenv("CC_SILENT_IDLE_RESET", tc.env)
+
+			p := &stubPlatformEngine{n: "test"}
+			agentSession := newResultAgentSession("fresh reply")
+			agent := &resultAgent{session: agentSession}
+			e := NewEngine("test", agent, []Platform{p}, "", LangEnglish)
+			e.SetResetOnIdle(60 * time.Minute)
+
+			key := "qq:g:100000001"
+			old := e.sessions.GetOrCreateActive(key)
+			old.AddHistory("user", "stale context")
+			old.SetAgentSessionID("old-session", "stub")
+			staleAt := time.Now().Add(-2 * time.Hour)
+			old.mu.Lock()
+			old.LastUserActivity = staleAt
+			old.UpdatedAt = staleAt
+			old.mu.Unlock()
+
+			// Attach a live agent session so the graceful-closing branch is exercised too.
+			prevAgent := newQueuingSession("old-live-agent")
+			e.interactiveMu.Lock()
+			e.interactiveStates[key] = &interactiveState{
+				agentSession: prevAgent,
+				platform:     p,
+				replyCtx:     "ctx",
+			}
+			e.interactiveMu.Unlock()
+
+			msg := &Message{
+				SessionKey: key,
+				Platform:   "test",
+				UserID:     "u1",
+				UserName:   "user",
+				Content:    "hello after idle",
+				ReplyCtx:   "ctx",
+			}
+			e.handleMessage(p, msg)
+
+			deadline := time.After(2 * time.Second)
+			for {
+				active := e.sessions.GetOrCreateActive(key)
+				sent := p.getSent()
+				hasFresh := false
+				for _, m := range sent {
+					if m == "fresh reply" {
+						hasFresh = true
+						break
+					}
+				}
+				if active.ID != old.ID && len(active.GetHistory(0)) >= 2 && hasFresh {
+					break
+				}
+				select {
+				case <-deadline:
+					t.Fatalf("timed out waiting for idle auto-reset, sent=%q active=%s old=%s", sent, active.ID, old.ID)
+				default:
+					time.Sleep(10 * time.Millisecond)
+				}
+			}
+
+			sent := p.getSent()
+			gotAutoReset := false
+			gotClosing := false
+			for _, m := range sent {
+				if strings.Contains(m, "Session auto-reset") {
+					gotAutoReset = true
+				}
+				if strings.Contains(m, "Wrapping up your previous session") {
+					gotClosing = true
+				}
+			}
+			if gotAutoReset != tc.wantNotice {
+				t.Fatalf("auto-reset notice sent = %v, want %v (sent: %q)", gotAutoReset, tc.wantNotice, sent)
+			}
+			if gotClosing != tc.wantNotice {
+				t.Fatalf("graceful-closing notice sent = %v, want %v (sent: %q)", gotClosing, tc.wantNotice, sent)
+			}
+		})
+	}
+}
