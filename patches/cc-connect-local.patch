diff --git a/core/autocompress_hardlimit_test.go b/core/autocompress_hardlimit_test.go
new file mode 100644
index 0000000..961d40a
--- /dev/null
+++ b/core/autocompress_hardlimit_test.go
@@ -0,0 +1,203 @@
+package core
+
+import (
+	"testing"
+	"time"
+)
+
+// Local patch: [projects.auto_compress] hard_max_tokens / hard_min_gap_mins.
+//
+// A very active session can cross max_tokens again shortly after an automatic
+// compression and then keep growing for the whole min_gap_mins window. The
+// optional hard ceiling lets auto-compress fire early once the estimate reaches
+// hard_max_tokens, still rate-limited by hard_min_gap_mins so a compaction that
+// leaves the context above the ceiling cannot thrash.
+
+// legacyAutoCompressTriggered is the pre-patch trigger formula, kept here so the
+// hard_max_tokens = 0 case can be checked against it verbatim.
+func legacyAutoCompressTriggered(estimate, maxTokens int, minGap time.Duration, last, now time.Time) bool {
+	return estimate >= maxTokens && (last.IsZero() || now.Sub(last) >= minGap)
+}
+
+func TestAutoCompressDecision_HardLimit(t *testing.T) {
+	now := time.Date(2026, 11, 24, 12, 0, 0, 0, time.UTC)
+	ago := func(d time.Duration) time.Time { return now.Add(-d) }
+
+	for _, tc := range []struct {
+		name       string
+		hardMax    int
+		hardMinGap time.Duration
+		estimate   int
+		last       time.Time
+		want       bool
+		wantReason string
+	}{
+		{"below max never triggers", 200_000, 3 * time.Minute, 119_999, ago(2 * time.Hour), false, "none"},
+		{"first compression is normal", 200_000, 3 * time.Minute, 120_000, time.Time{}, true, "normal"},
+		{"min gap elapsed is normal", 200_000, 3 * time.Minute, 250_000, ago(60 * time.Minute), true, "normal"},
+		{"above max, below hard, inside min gap waits", 200_000, 3 * time.Minute, 150_000, ago(15 * time.Minute), false, "none"},
+		{"above hard inside min gap triggers via hard path", 200_000, 3 * time.Minute, 230_000, ago(15 * time.Minute), true, "hard"},
+		{"exactly hard max triggers via hard path", 200_000, 3 * time.Minute, 200_000, ago(3 * time.Minute), true, "hard"},
+		{"above hard inside hard min gap does not trigger", 200_000, 3 * time.Minute, 385_000, ago(2 * time.Minute), false, "none"},
+		{"hard min gap defaults to 3m when unset", 200_000, 0, 230_000, ago(2 * time.Minute), false, "none"},
+		{"hard min gap default elapsed", 200_000, 0, 230_000, ago(3 * time.Minute), true, "hard"},
+		{"custom hard min gap respected", 200_000, 10 * time.Minute, 230_000, ago(5 * time.Minute), false, "none"},
+		{"hard max 0 disables the hard path", 0, 3 * time.Minute, 385_000, ago(15 * time.Minute), false, "none"},
+		{"negative hard max disables the hard path", -1, 3 * time.Minute, 385_000, ago(15 * time.Minute), false, "none"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			e := NewEngine("test", &stubAgent{}, nil, "", LangEnglish)
+			e.SetAutoCompressConfig(true, 120_000, 60*time.Minute)
+			e.SetAutoCompressHardLimit(tc.hardMax, tc.hardMinGap)
+
+			got, reason := e.autoCompressDecision(tc.estimate, tc.last, now)
+			if got != tc.want || reason != tc.wantReason {
+				t.Fatalf("autoCompressDecision(%d, last=%v) = (%v, %q), want (%v, %q)",
+					tc.estimate, now.Sub(tc.last), got, reason, tc.want, tc.wantReason)
+			}
+		})
+	}
+}
+
+// With hard_max_tokens unset (never configured) or explicitly 0, the decision
+// must match the original formula for every combination of estimate and gap.
+func TestAutoCompressDecision_HardLimitDisabled_MatchesLegacy(t *testing.T) {
+	now := time.Date(2026, 11, 24, 12, 0, 0, 0, time.UTC)
+	const maxTokens = 120_000
+	const minGap = 60 * time.Minute
+
+	estimates := []int{0, 1, 119_999, 120_000, 120_001, 230_000, 385_000, 10_000_000}
+	gaps := []time.Duration{-1, 0, time.Second, 2 * time.Minute, 3 * time.Minute, 15 * time.Minute,
+		59*time.Minute + 59*time.Second, 60 * time.Minute, 2 * time.Hour}
+
+	for _, configure := range []struct {
+		name string
+		set  func(e *Engine)
+	}{
+		{"never configured", func(e *Engine) {}},
+		{"explicit zero", func(e *Engine) { e.SetAutoCompressHardLimit(0, 0) }},
+		{"zero with custom gap", func(e *Engine) { e.SetAutoCompressHardLimit(0, time.Minute) }},
+	} {
+		t.Run(configure.name, func(t *testing.T) {
+			e := NewEngine("test", &stubAgent{}, nil, "", LangEnglish)
+			e.SetAutoCompressConfig(true, maxTokens, minGap)
+			configure.set(e)
+
+			for _, est := range estimates {
+				for _, gap := range gaps {
+					last := time.Time{}
+					if gap >= 0 {
+						last = now.Add(-gap)
+					}
+					want := legacyAutoCompressTriggered(est, maxTokens, minGap, last, now)
+					got, reason := e.autoCompressDecision(est, last, now)
+					if got != want {
+						t.Fatalf("estimate=%d gap=%v: got %v (%s), legacy formula says %v", est, gap, got, reason, want)
+					}
+					if got && reason != "normal" {
+						t.Fatalf("estimate=%d gap=%v: triggered with reason %q, want \"normal\"", est, gap, reason)
+					}
+				}
+			}
+		})
+	}
+}
+
+// runAutoCompressTurn drives one full turn through processInteractiveEvents
+// (the same path as TestAutoCompress_TriggerAfterResult) with exact usage
+// `used` and the previous automatic compression at `lastAgo` ago. It returns
+// the commands the agent session received and the state, after waiting `wait`
+// for the turn to settle (or until a send arrives when expectSend is true).
+func runAutoCompressTurn(t *testing.T, e *Engine, p Platform, used int, lastAgo time.Duration, expectSend bool) ([]string, *interactiveState) {
+	t.Helper()
+	sess := newQueuingSession("auto-compress-hard")
+	sess.contextUsage = &ContextUsage{UsedTokens: used, ContextWindow: 1_000_000}
+
+	key := "test:user1"
+	state := &interactiveState{
+		agentSession:       sess,
+		platform:           p,
+		replyCtx:           "ctx",
+		lastAutoCompressAt: time.Now().Add(-lastAgo),
+	}
+	e.interactiveMu.Lock()
+	e.interactiveStates[key] = state
+	e.interactiveMu.Unlock()
+
+	session := e.sessions.GetOrCreateActive(key)
+	session.AddHistory("user", "hello world")
+
+	go e.processInteractiveEvents(state, session, e.sessions, key, "msg1", time.Now(), func() {}, nil, nil, 0)
+	sess.events <- Event{Type: EventResult, Content: "response", Done: true}
+
+	if expectSend {
+		deadline := time.After(2 * time.Second)
+		for {
+			sess.sendMu.Lock()
+			n := len(sess.sendCalls)
+			sess.sendMu.Unlock()
+			if n > 0 {
+				break
+			}
+			select {
+			case <-deadline:
+				t.Fatal("timed out waiting for auto-compress send")
+			default:
+				time.Sleep(10 * time.Millisecond)
+			}
+		}
+	} else {
+		time.Sleep(300 * time.Millisecond)
+	}
+
+	sess.sendMu.Lock()
+	defer sess.sendMu.Unlock()
+	return append([]string(nil), sess.sendCalls...), state
+}
+
+func newHardLimitEngine(hardMax int, hardMinGap time.Duration) (*Engine, Platform) {
+	p := &stubPlatformEngine{n: "test"}
+	agent := &stubCompressorAgent{cmd: "/compact"}
+	e := NewEngine("test", agent, []Platform{p}, "", LangEnglish)
+	// Mirrors the deployment that motivated the patch: max 120K, min gap 60m.
+	e.SetAutoCompressConfig(true, 120_000, 60*time.Minute)
+	e.SetAutoCompressHardLimit(hardMax, hardMinGap)
+	return e, p
+}
+
+// 15 minutes after the last auto-compress the session is already at 230K:
+// min_gap (60m) has not elapsed, but hard_max_tokens (200K) is exceeded and
+// hard_min_gap (3m) has elapsed, so it must compress now.
+func TestAutoCompress_HardMax_TriggersBeforeMinGap(t *testing.T) {
+	e, p := newHardLimitEngine(200_000, 3*time.Minute)
+	sends, _ := runAutoCompressTurn(t, e, p, 230_000, 15*time.Minute, true)
+	if len(sends) == 0 || sends[len(sends)-1] != "/compact" {
+		t.Fatalf("expected /compact via hard_max_tokens, got %v", sends)
+	}
+}
+
+// Above hard_max_tokens but only 1 minute after the previous auto-compress:
+// hard_min_gap (3m) blocks it, and the decision is not recorded as a compress.
+func TestAutoCompress_HardMax_RespectsHardMinGap(t *testing.T) {
+	e, p := newHardLimitEngine(200_000, 3*time.Minute)
+	sends, state := runAutoCompressTurn(t, e, p, 385_000, time.Minute, false)
+	if len(sends) != 0 {
+		t.Fatalf("expected no auto-compress inside hard_min_gap, got %v", sends)
+	}
+	state.mu.Lock()
+	last := state.lastAutoCompressAt
+	state.mu.Unlock()
+	if time.Since(last) < 50*time.Second {
+		t.Fatalf("lastAutoCompressAt must not move when nothing was compressed, got %v ago", time.Since(last))
+	}
+}
+
+// hard_max_tokens = 0 keeps the original behavior: 230K at 15 minutes waits for
+// the 60-minute min gap, exactly as before the patch.
+func TestAutoCompress_HardMaxDisabled_KeepsMinGap(t *testing.T) {
+	e, p := newHardLimitEngine(0, 0)
+	sends, _ := runAutoCompressTurn(t, e, p, 230_000, 15*time.Minute, false)
+	if len(sends) != 0 {
+		t.Fatalf("expected no auto-compress before min_gap with hard_max_tokens=0, got %v", sends)
+	}
+}
